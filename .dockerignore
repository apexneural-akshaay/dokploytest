# Dependencies (reinstalled in container)
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output (rebuilt in container)
dist
build
.next
out

# Version control
.git
.gitignore
.gitattributes

# IDE and editor
.idea
.vscode
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Environment and secrets (never bake into image)
.env
.env.*
!.env.example

# Testing and coverage
coverage
.nyc_output
*.test.js
*.test.jsx
*.spec.js
*.spec.jsx
__tests__
__mocks__
e2e
cypress

# Documentation (optional to exclude)
README.md
docs
*.md
!nginx/*.conf

# Docker (avoid context recursion)
Dockerfile*
.dockerignore
docker-compose*
.docker

# Misc
*.log
.cache
